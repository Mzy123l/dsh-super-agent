{
  "name": "memory-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 会话记忆插件（纯理论实现）：全量索引会话日志，提供关键词 + 向量双路检索",
  "bin": {
    "memory-plugin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run --coverage",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
