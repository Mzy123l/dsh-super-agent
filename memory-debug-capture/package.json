{
  "name": "dsh-memory-debug-capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 调试采集插件：挂 llm/stream waterfall，把每次模型请求的完整上下文落盘为 JSONL（A/B 实测采集端）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "selftest": "node dist/cli.js --selftest",
    "integration": "node scripts/integration-check.mjs",
    "verify": "npm run build && npm run selftest && npm run integration"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "license": "GPL-3.0-or-later"
}
